Options All -Indexes

# ===== SEGURIDAD =====
# Bloquear acceso a archivos sensibles
<FilesMatch "^(\.env|\.htaccess|error_log|composer\.(json|lock)|.*\.md|migrate_passwords\.php)$">
  Require all denied
</FilesMatch>

# Bloquear acceso directo a archivos de código en carpetas internas
RewriteRule ^(Config|Libraries|Models|Controllers|Helpers)/(.*)$ - [F,L]
RewriteRule ^(Assets/uploads/certificates)/(.*)$ - [F,L]
RewriteRule ^(error_log\.php|.*\.sql)$ - [F,L]
RewriteRule ^migrate_passwords\.php$ - [F,L]

# Bloquear archivos de sistema
<FilesMatch "^(Thumbs\.db|\.htpasswd|\.git|\.svn|\.env|\.DS_Store)">
  Require all denied
</FilesMatch>

# ===== RENDIMIENTO =====
# Compresión Gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/x-javascript application/xml application/xml+rss
  # Excluir archivos que ya están comprimidos
  SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|ico|svg)$ no-gzip dont-vary
  SetEnvIfNoCase Request_URI \.(?:t?gz|zip|bz2|rar|7z)$ no-gzip dont-vary
</IfModule>

# Caché de assets estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/json "access plus 1 day"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# Headers de caché para assets
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  # Preload hints
  Header set Link "</css/default/app.min.css>; rel=preload; as=style"
  Header set Link "</js/app.min.js>; rel=preload; as=script"
</IfModule>

# Cabeceras de seguridad
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-XSS-Protection "1; mode=block"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set Permissions-Policy "microphone=(), camera=()"
  
  # Content Security Policy (ajustado para Google Maps y el sistema)
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://maps.googleapis.com https://maps.gstatic.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.googleapis.com https://maps.googleapis.com; font-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.gstatic.com; img-src 'self' data: https: blob: https://maps.googleapis.com https://maps.gstatic.com https://csi.gstatic.com; connect-src 'self' https://maps.googleapis.com https://maps.gstatic.com https://api.qrserver.com; frame-src 'self' https://maps.google.com https://maps.googleapis.com"
  
  # Cache control para archivos sensibles
  <FilesMatch "\.(php|html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  
  # Protección contra clickjacking
  Header always append X-Frame-Options SAMEORIGIN
  
  # Prevenir MIME sniffing
  Header set X-Content-Type-Options "nosniff"
</IfModule>

# ===== PROTECCIONES ADICIONALES =====
# Bloquear acceso a archivos de backup
<FilesMatch "\.(bak|backup|old|orig|save|swp|tmp)$">
  Require all denied
</FilesMatch>

# Bloquear acceso a archivos de configuración
<FilesMatch "\.(ini|conf|cfg|config)$">
  Require all denied
</FilesMatch>

# Bloquear acceso a archivos de log
<FilesMatch "\.(log|logs)$">
  Require all denied
</FilesMatch>

# Limitar tamaño de subida (10MB)
LimitRequestBody 10485760

# ===== REESCRITURA =====
RewriteEngine on
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]

# Redireccion HTTPS en produccion
RewriteEngine On
RewriteCond %{HTTP_HOST} ^internet\.mipaginaweb\.pe$ [OR]
RewriteCond %{HTTP_HOST} ^www\.internet\.mipaginaweb\.pe$
RewriteCond %{HTTPS} !on
RewriteRule ^(.*)$ https://internet.mipaginaweb.pe/$1 [R=301,L,NE]

# Bloquear directorios sin index
Options -Indexes

# Deshabilitar server signature
ServerSignature Off

# Ocultar versión de PHP
<IfModule mod_php7.c>
  php_flag expose_php Off
</IfModule>
<IfModule mod_php.c>
  php_flag expose_php Off
</IfModule>
