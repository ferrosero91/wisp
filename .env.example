# Copia este archivo a ".env" y completa los valores de tu entorno.
# NUNCA subas el archivo .env real (esta en .gitignore).

# URL base del sistema (sin slash final)
BASE_URL=http://localhost:8080/

# Base de datos
DB_HOST=localhost
DB_NAME=nacion17_internet
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8

# Nombre del sistema
NAME_SYSTEM=INTERNET SYSTEM

# Claves de encriptacion (genera claves unicas)
SECRET_KEY=change-me-in-production
SECRET_IV=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz1234567890

# Entorno: development | production
APP_ENV=development
APP_DEBUG=true
