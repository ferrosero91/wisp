# Copia este archivo a ".env" y completa los valores de tu entorno.
# NUNCA subas el archivo .env real (esta en .gitignore).

# URL base del sistema (sin slash final)
BASE_URL=http://localhost:8080/

# Base de datos
DB_HOST=localhost
DB_NAME=nacion17_internet
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8

# Nombre del sistema
NAME_SYSTEM=INTERNET SYSTEM

# Claves de encriptacion (genera claves unicas)
SECRET_KEY=change-me-in-production
SECRET_IV=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz1234567890

# Entorno: development | production
APP_ENV=development
APP_DEBUG=true

# ============================================================
# FACTURACION ELECTRONICA (APIDIAN)
# ============================================================
# URL base de la API APIDIAN (sin slash final)
# APIDIAN_URL=https://tu-dominio-apidian.com/api/ubl2.1

# Token de autenticacion (se obtiene al configurar la empresa)
# APIDIAN_TOKEN=

# NIT de la empresa y digito verificador
# APIDIAN_NIT=900123456
# APIDIAN_DV=7

# Ambiente: habilitacion (pruebas) | produccion
# APIDIAN_ENVIRONMENT=habilitacion

# Prefijo autorizado por la DIAN
# APIDIAN_PREFIX=SETP

# Numero de resolucion DIAN
# APIDIAN_RESOLUTION=18760000001

# Rango de numeracion autorizada
# APIDIAN_RESOLUTION_FROM=1
# APIDIAN_RESOLUTION_TO=999999999
