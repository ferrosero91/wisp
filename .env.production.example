# ============================================================
# Variables de entorno para Producción (Docker/Dokploy)
# Copia este archivo y configura los valores en Dokploy
# ============================================================

# Puerto del contenedor (Dokploy asigna el puerto externo)
APP_PORT=8080

# URL base del sistema (con tu dominio real)
BASE_URL=https://tu-dominio.com/

# Base de datos
DB_NAME=nacion17_internet
DB_USER=wisp_user
DB_PASSWORD=TuPasswordSeguro123!

# MariaDB Root Password (solo para inicialización)
MYSQL_ROOT_PASSWORD=RootPasswordSeguro456!

# Nombre del sistema
NAME_SYSTEM=INTERNET SYSTEM

# Claves de encriptacion (GENERAR VALORES UNICOS Y SEGUROS)
# Puedes generar con: openssl rand -hex 32
SECRET_KEY=genera-una-clave-aleatoria-larga-aqui
SECRET_IV=genera-un-iv-aleatorio-de-64-caracteres-aqui

# Entorno
APP_ENV=production
APP_DEBUG=false

# ============================================================
# FACTURACION ELECTRONICA (APIDIAN) - OPCIONAL
# ============================================================
# Descomenta y configura si usas facturación electrónica

# APIDIAN_URL=https://tu-dominio-apidian.com/api/ubl2.1
# APIDIAN_TOKEN=tu-token-aqui
# APIDIAN_NIT=900123456
# APIDIAN_DV=7
# APIDIAN_ENVIRONMENT=produccion
# APIDIAN_PREFIX=SETP
# APIDIAN_RESOLUTION=18760000001
# APIDIAN_RESOLUTION_FROM=1
# APIDIAN_RESOLUTION_TO=999999999
